@page "/"
@using KBUI_Explorer.Models
@using KBUI_Explorer.Services
@using Markdig
@inject QueryApiClient Api
@inject NavigationManager Nav

<PageTitle>KBUI Explorer</PageTitle>

<main class="explorer">
    <header class="hero">
        <h1>KBUI Explorer</h1>
        <p class="badge">Query-only · Rag_Ingestion_Tool</p>
        <p class="meta">@_healthText</p>
        @if (!_isGitHubPages)
        {
            <p class="lock">This app can only call <code>/health</code>, <code>/search</code>, <code>/rag/query</code>, and
                <code>/chat</code>. Ingest and index admin are blocked.
            </p>
        }
    </header>

    @if (!_isGitHubPages)
    {
        <section class="panel settings">
            <div class="row">
                <label for="base">API base URL</label>
                <input id="base" @bind="_apiBase" placeholder="https://app-q-cpy-hud-dev.azurewebsites.net" />
            </div>
            <div class="row">
                <label for="key">API key (optional — required when API demo hardening is on)</label>
                <input id="key" type="password" @bind="_apiKey" autocomplete="off" />
            </div>
            <button type="button" class="secondary" disabled="@_busy" @onclick="SaveAndPingAsync">Save &amp; check
                health</button>
            </section>
        }

        <section class="panel">
            <div class="row">
                <div
                    style="display:flex; justify-content:space-between; align-items:center; gap:0.75rem; margin-bottom:0.5rem;">
                    <label for="q" style="margin:0;">Question</label>
                    <span class="hint" style="margin:0;">Max @_maxLen characters</span>
                </div>
                <textarea id="q" @bind="_question" maxlength="@Api.MaxQuestionLength"
                          placeholder="What is the HOME program?" rows="4"></textarea>
            </div>

            <div class="call-line">
                <span class="legend">Call</span>
                <InputRadioGroup @bind-Value="_mode">
                    <label class="call-option">
                        <InputRadio Value="@QueryMode.Rag" /> RAG
                    </label>
                    <label class="call-option">
                        <InputRadio Value="@QueryMode.Chat" /> Chat only
                    </label>
                </InputRadioGroup>
            </div>

            <button type="button" disabled="@_busy" @onclick="RunAsync">Run</button>
        </section>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="err">@_error</p>
        }

        @if (_rag is not null)
        {
            var finalPrompt = GetFinalPrompt(_rag);
            var retrievedContext = GetRetrievedContext(_rag);
            var messagesText = GetMessagesText(_rag);
            var documentCitations = DocumentCitations(_rag);
            var endCitations = EndCitations(_rag);

            <section class="results-card" aria-label="RAG results">
                <div class="results-header">
                    <span class="pill">RAG result</span>
                    @if (!string.IsNullOrEmpty(_rag.Source))
                    {
                        <span class="source-chip">@_rag.Source</span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_rag.Answer))
                {
                    <div class="results-block">
                        <h2 class="legend">Answer</h2>
                        <div class="markdown">@((MarkupString)ToHtml(_rag.Answer))</div>
                    </div>
                }

                @if (endCitations.Count > 0)
                {
                    <div class="results-block">
                        <h2 class="legend">Citation RAG Request</h2>
                        <div>______________________________</div>
                        @foreach (var c in endCitations)
                        {
                            <aside class="end-citation" aria-label="RAG request">
                                <span class="pill">Citation RAG Request</span>
                                <strong>@(string.IsNullOrWhiteSpace(c.Title) ? "RAG request" : c.Title)</strong>
                                <span class="src">@(c.DisplaySourceFile ?? "rag://request")</span>
                                @if (!string.IsNullOrWhiteSpace(c.Content))
                                {
                                    <pre>@c.Content</pre>
                                }
                            </aside>
                        }
                    </div>
                }

                @if (documentCitations.Count > 0)
                {
                    <div class="results-block">
                        <h2 class="legend">Citations</h2>
                        @foreach (var c in documentCitations)
                        {
                            <div class="hit">
                                <div class="src">@(c.Title ?? "") · @(c.DisplaySourceFile ?? "")</div>
                            </div>
                        }
                    </div>
                }

                @if (_rag.Hits.Count > 0)
                {
                    <div class="results-block">
                        <h2 class="legend">Hits</h2>
                        @foreach (var h in _rag.Hits)
                        {
                            <div class="hit">
                                <div class="src">@h.DisplaySource@(h.Score is double s ? $" · score {s}" : "")</div>
                                @Snippet(h.Content)
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(finalPrompt) || !string.IsNullOrWhiteSpace(retrievedContext) || !string.IsNullOrWhiteSpace(messagesText))
                {
                    <div class="results-block details">
                        <h2 class="legend">Prompt details</h2>
                        @if (!string.IsNullOrWhiteSpace(finalPrompt))
                        {
                            <p class="legend">Final Azure prompt</p>
                            <div class="hit">
                                <pre>@finalPrompt</pre>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(retrievedContext))
                        {
                            <p class="legend">Retrieved context sent to model</p>
                            <div class="hit">
                                <pre>@retrievedContext</pre>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(messagesText))
                        {
                            <p class="legend">System prompt / messages</p>
                            <div class="hit">
                                <pre>@messagesText</pre>
                            </div>
                        }
                    </div>
                }
            </section>
        }

        @if (_search is not null)
        {
            <section class="results-card" aria-label="Search results">
                <div class="results-header">
                    <span class="pill">Search result</span>
                    @if (!string.IsNullOrEmpty(_search.Source))
                    {
                        <span class="source-chip">@_search.Source</span>
                    }
                </div>
                <div class="results-block">
                    <h2 class="legend">Hits</h2>
                    @foreach (var h in _search.Hits)
                    {
                        <div class="hit">
                            <div class="src">@h.DisplaySource@(h.Score is double s ? $" · score {s}" : "")</div>
                            @Snippet(h.Content)
                        </div>
                    }
                </div>
            </section>
        }

        @if (_chat is not null && !string.IsNullOrEmpty(_chat.Answer))
        {
            <section class="results-card" aria-label="Chat results">
                <div class="results-header">
                    <span class="pill">Chat result</span>
                    @if (!string.IsNullOrEmpty(_chat.Source))
                    {
                        <span class="source-chip">@_chat.Source</span>
                    }
                </div>
                <div class="results-block">
                    <h2 class="legend">Answer</h2>
                    <div class="markdown">@((MarkupString)ToHtml(_chat.Answer))</div>
                </div>
            </section>
        }
    </main>

@code {
    private string _apiBase = "";
    private string _apiKey = "";
    private string _question = "";
    private string _healthText = "Checking API…";
    private string _ragQuestionText = "";
    private string? _error;
    private bool _busy;
    private bool _isGitHubPages => Nav.BaseUri.Contains("github.io", StringComparison.OrdinalIgnoreCase);
    private QueryMode _mode = QueryMode.Rag;
    private int _topK = 3;
    private int _maxLen;
    private int _maxTopK;
    private SearchResponse? _search;
    private RagResponse? _rag;
    private ChatResponse? _chat;

    protected override async Task OnInitializedAsync()
    {
        _apiBase = Api.ApiBaseUrl;
        _apiKey = Api.ApiKey;
        _maxLen = Api.MaxQuestionLength;
        _maxTopK = Api.MaxTopK;
        _topK = Math.Min(3, _maxTopK);
        await PingHealthAsync();
    }

    private async Task SaveAndPingAsync()
    {
        _error = null;
        try
        {
            Api.UpdateConnection(_apiBase, _apiKey);
            await PingHealthAsync();
        }
        catch (Exception ex)
        {
            _healthText = "Not connected";
            _error = ex.Message;
        }
    }

    private async Task PingHealthAsync()
    {
        try
        {
            var h = await Api.GetHealthAsync();
            if (string.Equals(h.Status, "ok", StringComparison.OrdinalIgnoreCase))
            {
                _healthText = $"{h.Profile} · {h.Index} · mode {h.Mode} · {Api.ApiBaseUrl}";
                if (!string.Equals(h.Mode, "query", StringComparison.OrdinalIgnoreCase))
                {
                    _healthText += " ⚠ API is not in query-only mode — still blocked from ingest in this app";
                }
            }
            else
            {
                _healthText = "API health unexpected";
            }
        }
        catch (Exception ex)
        {
            _healthText = $"Query API is not reachable at {Api.ApiBaseUrl}.";
            _error = ex.Message;
        }
    }

    private async Task RunAsync()
    {
        _error = null;
        _search = null;
        _rag = null;
        _chat = null;
        _ragQuestionText = "";
        _busy = true;

        try
        {
            if (!_isGitHubPages)
            {
                Api.UpdateConnection(_apiBase, _apiKey);
            }

            switch (_mode)
            {
                case QueryMode.Search:
                    _search = await Api.SearchAsync(_question, _topK);
                    break;
                case QueryMode.Rag:
                    _ragQuestionText = _question.Trim();
                    _rag = await Api.RagAsync(_question, _topK);
                    break;
                case QueryMode.Chat:
                    _chat = await Api.ChatAsync(_question);
                    break;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static List<Citation> EndCitations(RagResponse rag) =>
        rag.Citations.Where(c => c.IsEndCitation).ToList();

    private static List<Citation> DocumentCitations(RagResponse rag) =>
        rag.Citations.Where(c => !c.IsEndCitation).ToList();

    private string GetFinalPrompt(RagResponse rag)
    {
        var promptText = FirstNonEmpty(
            rag.FinalPrompt,
            rag.AzurePrompt,
            rag.Prompt,
            rag.PromptText,
            rag.SystemPrompt,
            rag.Messages.Count > 0 ? string.Join("\n\n", rag.Messages.Select(m => $"[{m.Role ?? "role"}]\n{m.Content ?? ""}")) :
null,
            _ragQuestionText);

        return promptText;
    }

    private static string GetRetrievedContext(RagResponse rag)
    {
        return FirstNonEmpty(rag.ContextText, rag.RetrievedContext);
    }

    private string GetMessagesText(RagResponse rag)
    {
        if (!string.IsNullOrWhiteSpace(rag.SystemPrompt))
        {
            if (rag.Messages.Count == 0)
                return rag.SystemPrompt;

            return string.Join("\n\n", rag.Messages.Select(m => $"[{m.Role ?? "role"}]\n{m.Content ?? ""}"));
        }

        if (rag.Messages.Count == 0)
            return string.Empty;

        return string.Join("\n\n", rag.Messages.Select(m => $"[{m.Role ?? "role"}]\n{m.Content ?? ""}"));
    }

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
                return value;
        }

        return string.Empty;
    }

    private static string ToHtml(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return "";

        return Markdown.ToHtml(content);
    }

    private static string Snippet(string? content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        return content.Length > 800 ? content[..800] + "…" : content;
    }
}
